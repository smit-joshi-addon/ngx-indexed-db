{
  "name": "@smit.advenix/ngx-indexed-db",
  "version": "22.1.0",
  "files": [
    "dist/ngx-indexed-db/**/*"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:playground": "ng serve --project playground",
    "start:ssr-playground": "ng serve --project ssr-playground",
    "build:lib": "ng build --project ngx-indexed-db -c production",
    "watch:lib": "ng build --project ngx-indexed-db -c development",
    "build:playground": "ng build --project playground",
    "build:library": "ng build --project ngx-indexed-db",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier \"projects/**/*.{ts,json}\" --write",
    "serve:ssr:ssr-playground": "node dist/ssr-playground/server/server.mjs"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write"
    ],
    "*.{css}": [
      "prettier --write"
    ],
    "projects/ngx-indexed-db/**/*.{tsx,js}": [
      "ng lint"
    ]
  },
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/ssr": "^22.2.0",
    "express": "^4.22.1",
    "rxjs": "^7.0.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.1",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/express": "^4.17.25",
    "@types/node": "^24.10.7",
    "angular-eslint": "^22.5.0",
    "commitlint": "^21.2.3",
    "eslint": "^10.11.0",
    "husky": ">=4",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.1",
    "lint-staged": "^16.2.7",
    "ng-packagr": "^22.2.3",
    "prettier": "2.1.1",
    "ts-node": "~8.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "types": "dist/ngx-indexed-db/lib/ngx-indexed-db.meta.d.ts"
}
